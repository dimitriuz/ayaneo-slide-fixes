[Unit]
Description=AYANEO tray privileged helper (fan, SMU power limits, charge limit, platform profile)
Documentation=https://github.com/dimitriuz/ayaneo-slide-fixes

[Service]
Type=simple
ExecStart=/usr/bin/ayaneo-tray --helper
Group=wheel
RuntimeDirectory=ayaneo-tray
RuntimeDirectoryMode=0750
# The charge limit is kept here so it survives a reboot and applies before
# anyone logs in. ProtectSystem=strict would otherwise make /var/lib read-only.
StateDirectory=ayaneo
# The helper only spawns ryzenadj and writes one sysfs file; keep the rest away.
ProtectHome=yes
ProtectSystem=strict
ReadWritePaths=/sys/firmware/acpi/platform_profile
# Fan control is raw port I/O through /dev/port.
DeviceAllow=/dev/port rw
# Whatever happens to the process, the fan goes back to the EC's own curve.
ExecStopPost=/usr/bin/ayaneo-tray --fan-auto
NoNewPrivileges=no
RestrictAddressFamilies=AF_UNIX
MemoryDenyWriteExecute=yes
# CAP_SYS_ADMIN is what lets ryzenadj write PCI config space past the first 64
# bytes, which is where the SMU mailbox is. Without it every TDP write fails
# with "PCI Bus is not writeable, check secure boot" - a message that sends you
# looking at firmware rather than at this line. It is a broad capability, but
# CAP_SYS_RAWIO above already permits arbitrary port I/O, so it does not widen
# what this helper could do if it were subverted.
CapabilityBoundingSet=CAP_SYS_RAWIO CAP_DAC_OVERRIDE CAP_SYS_ADMIN
Restart=on-failure

[Install]
WantedBy=multi-user.target
