# ayaneo-tray - grant the active session user access to the two devices the
# GUI drives directly, so it never needs root, a setuid helper, or polkit.

# The gamepad MCU: an on-board 16550 UART at I/O 0x3E8 (COM3). Matched by
# address rather than by name, because ttyS numbering is not stable across
# machines and only this address carries the GuLiKit MCU.
SUBSYSTEM=="tty", ATTR{io_type}=="0", ATTR{port}=="0x3E8", \
  TAG+="uaccess", GROUP="uucp", MODE="0660"

# The keyboard backlight MCU. Interface 01 is the vendor interface carrying
# feature report 0x41; interface 00 is the real keyboard and is deliberately
# NOT granted, since access to it would mean access to keystrokes.
#
# Matched on a single attribute of a single parent, which is a hard udev
# constraint: KERNELS, SUBSYSTEMS and ATTRS keys in one rule must all resolve
# on the *same* parent device. bInterfaceNumber lives on the USB interface
# while idVendor/idProduct live on the USB device one level up, so the obvious
# combination silently never matches. The interface's modalias carries vendor,
# product and interface number together:
#     usb:v1C4Fp007Cd0108dc00dsc00dp00ic03isc00ip00in01
#                                                    ^^^^ interface number
SUBSYSTEM=="hidraw", ATTRS{modalias}=="usb:v1C4Fp007C*in01", \
  TAG+="uaccess", GROUP="input", MODE="0660"

# Joystick ring LEDs. sysfs attributes cannot take uaccess, so widen the group
# instead. Harmless where the distro already hands these to the seat user.
# ACTION!="remove" rather than =="add", so `udevadm trigger` (which sends
# "change") re-applies it too.
ACTION!="remove", SUBSYSTEM=="leds", KERNEL=="ayaneo:*", \
  RUN+="/bin/sh -c 'chgrp video /sys%p/brightness /sys%p/multi_intensity 2>/dev/null; chmod g+w /sys%p/brightness /sys%p/multi_intensity 2>/dev/null'"
